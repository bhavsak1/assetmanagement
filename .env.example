# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# The service-role key never goes in this file or in any web config (CLAUDE.md §6.4).

# Web app (public, shipped to the browser). Local values come from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# The custom service (services/api). Local: npm run dev in services/api. Staging: the Cloud Run URL (README).
VITE_API_URL=http://localhost:8080

# Supabase CLI only (link and push to staging). Not read by the web app.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# services/api has its own .env.example (DATABASE_URL, SUPABASE_URL, PORT, SUPABASE_ANON_KEY for tests).

# Story 9.1b: Auth SMTP for staging, read by `supabase config push` only. Set in your shell, never in git.
SUPABASE_AUTH_SMTP_PASS=
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=
