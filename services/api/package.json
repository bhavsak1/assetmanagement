{
  "name": "@assetly/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --env-file=.env src/index.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.ts",
    "eval": "node --env-file-if-exists=.env eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@anthropic-ai/vertex-sdk": "1.1.2",
    "@fastify/cors": "11.4.0",
    "@fastify/swagger": "9.9.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "saxes": "6.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
