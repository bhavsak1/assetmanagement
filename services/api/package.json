{
  "name": "@assetly/api",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --env-file=.env src/index.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
