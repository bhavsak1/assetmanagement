# Copy to .env (git-ignored). Local values only; staging reads DATABASE_URL from Secret Manager.
# assetly_api password is the local test value from supabase/seed.sql.
DATABASE_URL=postgres://assetly_api:assetly-local-api@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
PORT=8080
# Web origins allowed to call the service (comma separated). Staging: https://assetly-staging.pages.dev
CORS_ORIGINS=http://localhost:5173
# Tests only: from `npx supabase status -o env` (ANON_KEY).
SUPABASE_ANON_KEY=
# Story 9.1, the daily email job. Off locally unless JOBS_AUDIENCE is set. Staging: JOBS_DATABASE_URL and
# EMAIL_API_KEY from Secret Manager. assetly_jobs password is the local test value from supabase/seed.sql.
JOBS_DATABASE_URL=postgres://assetly_jobs:assetly-local-jobs@127.0.0.1:54322/postgres
# This service's own URL (the OIDC audience Cloud Scheduler signs for), and the scheduler's service account.
JOBS_AUDIENCE=
JOBS_INVOKER=
# Resend API key (send rights only) and the verified sender, e.g. Assetly <alerts@your-domain>.
EMAIL_API_KEY=
EMAIL_FROM=
# Web app base URL for links in emails. Staging: https://assetly-staging.pages.dev
APP_URL=http://localhost:5173
